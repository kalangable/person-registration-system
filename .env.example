# ==============================================================================
# Foundation Service - Variáveis de Ambiente
# ==============================================================================
# IMPORTANTE: Este arquivo NÃO deve ser commitado no Git!
# Copie este arquivo para .env e configure os valores conforme seu ambiente.
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foundationdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server Configuration
SERVER_PORT=8080

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Liquibase Configuration (para uso do Maven plugin via linha de comando)
LIQUIBASE_URL=jdbc:postgresql://localhost:5432/foundationdb
LIQUIBASE_USERNAME=postgres
LIQUIBASE_PASSWORD=postgres

# Jasypt Encryption (opcional - para criptografar senhas)
# JASYPT_ENCRYPTOR_PASSWORD=sua-senha-secreta-aqui
